{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "noImplicitAny": false,
        "sourceMap": false,
        "strict": true,
        "jsx": "preserve",
        "moduleResolution": "node",
        "noImplicitThis": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "@book/*": ["packages/soranoiseki/book-group/src/Resources/js/*"]
        }
    },
    "include": ["./**/*.ts", "./**/*.d.ts", "./**/*.vue"]
}
